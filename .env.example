# The app connects to PostgreSQL as a NON-superuser role so that row-level
# security (the TEN-1 second line of defence) is actually enforced. A superuser
# or a role with BYPASSRLS would silently skip every tenant policy.
#
# Create that role once (see prisma/migrations/0001_init_tenant_rls/migration.sql
# header for the grants it needs), then point DATABASE_URL at it:
DATABASE_URL="postgresql://teasoo_app:change-me@localhost:5432/teasoo_set?schema=public"

# The cross-tenant platform-analytics path (TEN-2) connects as a SEPARATE role
# that has SELECT on the metadata-only view and NO privilege on the base tables,
# so it can never read stakeholder names or engagement notes. See the header of
# prisma/migrations/0002_platform_metrics_view/migration.sql.
ANALYTICS_DATABASE_URL="postgresql://teasoo_analytics:change-me@localhost:5432/teasoo_set?schema=public"
