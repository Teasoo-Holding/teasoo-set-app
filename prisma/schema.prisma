// Teasoo SET — Prisma schema
//
// EP1-S1 / TEN-1: tenant isolation. Every tenant-scoped table carries a
// `tenant_id`. The application layer injects it automatically (see
// src/tenancy), and the database enforces it independently via row-level
// security (see the migration SQL). Neither layer relies on developer
// discipline at the call site.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @unique
  name          String
  createdAt     DateTime             @default(now()) @map("created_at")
  stakeholders  Stakeholder[]
  encryptionKey TenantEncryptionKey?
  users         User[]
  domains       TenantDomain[]
  authSettings  TenantAuthSettings?

  @@map("tenants")
}

/// Per-tenant precedence for resolving role/function/reporting-line at sign-in
/// (AUTH-2): whether IdP claims or the SET user record wins, and which JWT claim
/// carries each attribute.
model TenantAuthSettings {
  tenantId                    String  @id @map("tenant_id") @db.Uuid
  precedence                  String  @default("record_first") // 'record_first' | 'idp_first'
  roleClaim                   String? @map("role_claim")
  functionClaim               String? @map("function_claim")
  reportsToClaim              String? @map("reports_to_claim")
  authTimeClaim               String? @map("auth_time_claim")
  sessionTimeoutMobileMinutes Int     @default(720) @map("session_timeout_mobile_minutes")
  sessionTimeoutDesktopMinutes Int    @default(480) @map("session_timeout_desktop_minutes")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_auth_settings")
}

/// A user of a tenant. Identity is federated via Supabase Auth (SSO); this
/// record maps a verified email/subject to the tenant, role and function that
/// authorization uses. `supabaseUserId` is the Supabase `sub` claim.
model User {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  email          String
  role           String
  functionId     String?  @map("function_id") @db.Uuid
  reportsToId    String?  @map("reports_to_id") @db.Uuid
  status         String   @default("active")
  supabaseUserId String?  @unique @map("supabase_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  reportsTo User?  @relation("UserReports", fields: [reportsToId], references: [id])
  reports   User[] @relation("UserReports")

  @@unique([tenantId, email])
  @@map("users")
}

/// Email-domain → tenant routing (AUTH-1). A verified email's domain selects the
/// tenant the user belongs to.
model TenantDomain {
  domain   String @id
  tenantId String @map("tenant_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_domains")
}

/// Append-only, hash-chained audit event (EP1-S12 skeleton; GOV-4 extends it).
/// `hash` = SHA256(prevHash + canonical(event)); the per-tenant chain makes any
/// retrospective alteration, deletion or reordering detectable (ABC-4). The
/// table is also protected by an append-only trigger (see the migration).
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  seq          Int
  occurredAt   DateTime @map("occurred_at")
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json
  prevHash     String   @map("prev_hash")
  hash         String

  @@unique([tenantId, seq])
  @@index([tenantId, seq])
  @@map("audit_events")
}

/// Per-tenant envelope-encryption key (TEN-3). `wrappedDek` is the tenant's Data
/// Encryption Key, itself encrypted with the master KEK. Setting it NULL and
/// stamping `destroyedAt` is crypto-shredding: every free-text value encrypted
/// under that DEK becomes permanently unrecoverable — the mechanism for
/// contractual data deletion.
model TenantEncryptionKey {
  tenantId    String    @id @map("tenant_id") @db.Uuid
  wrappedDek  Bytes?    @map("wrapped_dek")
  keyVersion  Int       @default(1) @map("key_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  destroyedAt DateTime? @map("destroyed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_encryption_keys")
}

/// Minimal tenant-scoped model, present only to prove the TEN-1 mechanism.
/// The full stakeholder registry is EP-2 (REG-1..REG-6) and will extend this.
model Stakeholder {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("stakeholders")
}
