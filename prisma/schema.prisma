// Teasoo SET — Prisma schema
//
// EP1-S1 / TEN-1: tenant isolation. Every tenant-scoped table carries a
// `tenant_id`. The application layer injects it automatically (see
// src/tenancy), and the database enforces it independently via row-level
// security (see the migration SQL). Neither layer relies on developer
// discipline at the call site.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @unique
  name          String
  createdAt     DateTime             @default(now()) @map("created_at")
  stakeholders  Stakeholder[]
  encryptionKey TenantEncryptionKey?

  @@map("tenants")
}

/// Per-tenant envelope-encryption key (TEN-3). `wrappedDek` is the tenant's Data
/// Encryption Key, itself encrypted with the master KEK. Setting it NULL and
/// stamping `destroyedAt` is crypto-shredding: every free-text value encrypted
/// under that DEK becomes permanently unrecoverable — the mechanism for
/// contractual data deletion.
model TenantEncryptionKey {
  tenantId    String    @id @map("tenant_id") @db.Uuid
  wrappedDek  Bytes?    @map("wrapped_dek")
  keyVersion  Int       @default(1) @map("key_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  destroyedAt DateTime? @map("destroyed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_encryption_keys")
}

/// Minimal tenant-scoped model, present only to prove the TEN-1 mechanism.
/// The full stakeholder registry is EP-2 (REG-1..REG-6) and will extend this.
model Stakeholder {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("stakeholders")
}
